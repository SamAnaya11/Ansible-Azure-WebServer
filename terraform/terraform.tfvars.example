# Copia este archivo a terraform.tfvars y ajusta los valores.
# terraform.tfvars está en .gitignore: tu IP real nunca se sube a Git.

prefijo            = "labweb"
ubicacion          = "spaincentral"
tamano_vm          = "Standard_B2ts_v2"
ruta_clave_publica = "~/.ssh/lab_azure_ed25519.pub"
usuario_admin      = "azureuser"

# Tu IP pública IPv4 (obtenla con: curl -4 -s https://ifconfig.me)
# 203.0.113.10 es una IP reservada para documentación: SUSTITÚYELA.
ip_admin = "203.0.113.10"
